<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Paquetes Shells (Unimar.Shells.Net.*), publicados en GitHub Packages.
         Requiere un token con scope read:packages. Las credenciales no se versionan:
         se inyectan por NuGetPackageSourceCredentials_shells o por el secret del CI.
         La URL conserva el nombre del feed donde está publicado el paquete. -->
    <add key="shells" value="https://nuget.pkg.github.com/unimar-peru/index.json" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Cada paquete se resuelve desde un único origen: los Shells solo desde el
       feed corporativo y el resto solo desde nuget.org (mitiga la confusión de
       dependencias). -->
  <packageSourceMapping>
    <packageSource key="shells">
      <package pattern="Unimar.Shells.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
