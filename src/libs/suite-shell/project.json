{
  "name": "suite-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/suite-shell/src",
  "tags": ["scope:suite", "type:feature"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/suite-shell/tsconfig.json", "cwd": "{workspaceRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint libs/suite-shell", "cwd": "{workspaceRoot}" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run libs/suite-shell --passWithNoTests", "cwd": "{workspaceRoot}" }
    }
  }
}
