{
  "name": "ui-sil",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/ui-sil/src",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/ui-sil/tsconfig.json", "cwd": "{workspaceRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint libs/ui-sil", "cwd": "{workspaceRoot}" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run libs/ui-sil --passWithNoTests", "cwd": "{workspaceRoot}" }
    }
  }
}
