{
  "name": "suite-header",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/suite-header/src",
  "tags": ["scope:suite-api", "type:ui"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/suite-header/tsconfig.json", "cwd": "{workspaceRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint libs/suite-header", "cwd": "{workspaceRoot}" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run libs/suite-header --passWithNoTests", "cwd": "{workspaceRoot}" }
    }
  }
}
