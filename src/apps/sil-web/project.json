{
  "name": "sil-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/sil-web/src",
  "tags": ["type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "vite --config apps/sil-web/vite.config.ts", "cwd": "{workspaceRoot}" }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "vite preview --config apps/sil-web/vite.config.ts", "cwd": "{workspaceRoot}" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "vite build --config apps/sil-web/vite.config.ts", "cwd": "{workspaceRoot}" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/sil-web/tsconfig.json", "cwd": "{workspaceRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint apps/sil-web", "cwd": "{workspaceRoot}" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run apps/sil-web", "cwd": "{workspaceRoot}" }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "playwright test -c apps/sil-web/playwright.config.ts", "cwd": "{workspaceRoot}" }
    }
  }
}
