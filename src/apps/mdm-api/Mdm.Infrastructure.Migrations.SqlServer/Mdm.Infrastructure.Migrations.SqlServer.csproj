<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ensamblado de migraciones de SQL Server (ADR-0229 §3.6). Solo el andamiaje del esquema `mdm`:
    ni lógica de dominio ni repositorios. Infrastructure lo referencia por nombre
    (DependencyInjection.MigrationsAssembly) y no depende de él; es este proyecto el que depende
    de Infrastructure para ver MdmDbContext. Las migraciones nunca se aplican en el arranque de la
    API: las aplica quien despliega (MdmDatabaseMigrator).
  -->

  <PropertyGroup>
    <!-- Las migraciones las genera `dotnet ef`; sus avisos de estilo no aportan aquí. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Mdm.Infrastructure/Mdm.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
