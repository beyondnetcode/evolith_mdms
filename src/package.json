{
  "name": "sil-monorepo-workspace",
  "version": "1.0.0",
  "description": "Monorepo de MDM (datos maestros) de Organización: .NET 10 y Node.js 24 sobre Nx",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:all": "nx run-many -t build",
    "test:all": "nx run-many -t test",
    "typecheck:all": "nx run-many -t typecheck",
    "lint:all": "nx run-many -t lint",
    "dev:sil-web": "nx run sil-web:serve",
    "tokens:generate": "node libs/ui-tokens/scripts/build-tokens.mjs",
    "tokens:check": "node libs/ui-tokens/scripts/build-tokens.mjs --check",
    "bundle:check": "node ../scripts/presupuesto-bundle.mjs",
    "sbom": "node ../scripts/generar-sbom.mjs",
    "verify": "bash ../scripts/verify-local.sh full",
    "verify:fast": "bash ../scripts/verify-local.sh fast",
    "verify:prepush": "bash ../scripts/verify-local.sh prepush"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@material/material-color-utilities": "0.4.0",
    "@nx/eslint-plugin": "23.3.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "27.4.0",
    "nx": "23.3.0",
    "style-dictionary": "5.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "react": "$react",
    "react-dom": "$react-dom",
    "undici": "7.30.0"
  }
}
